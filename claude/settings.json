{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(tmux:*)",
      "Bash(git:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(perl:*)",
      "Bash(for:*)",
      "Bash(python:*)",
      "Bash(cd:*)",
      "Bash(crit:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(rec:*)",
      "Bash(caption:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Read(~/.zshrc)",
      "Read(~/.claude)",
      "Read(~/.config)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(pnpm supabase db reset)",
      "Bash(brew:*)",
      "Bash(terraform apply)",
      "Bash(terraform destroy)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "crit plan-hook",
            "timeout": 345600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-research.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-research-stop.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-stop.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-approval.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/save-plan-adr.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-approval.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "last30days@last30days-skill": true
  },
  "extraKnownMarketplaces": {
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skillOverrides": {
    "article-check": "off",
    "crit-cli": "off",
    "crit-stop-all": "off",
    "frontend-design": "off",
    "humanizer-ja": "off",
    "japanese-writing": "off",
    "keihi": "off",
    "notion-receipt-url-fill": "off",
    "review-all": "off",
    "rewrite-as-final": "off",
    "title-cybozu": "off",
    "video": "off",
    "check-missed": "off",
    "fix-build": "off",
    "fix-conflict": "off",
    "fix-test": "off",
    "issues": "off",
    "lint": "off",
    "local-docs": "off",
    "local-jira": "off",
    "local-md-list": "off",
    "local-review-log": "off",
    "local-review-summary": "off",
    "md": "off",
    "md-update": "off",
    "pr-create": "off",
    "pr-self-review": "off",
    "pr-update-description": "off",
    "quality-check": "off",
    "refactor-hosyu": "off",
    "review-arch": "off",
    "review-degure": "off",
    "review-konpon": "off",
    "review-tekku": "off",
    "tmux-leader-test": "off"
  }
}
