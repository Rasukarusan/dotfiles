{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/whiteboard"
  },
  "includeCoAuthoredBy": false,
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/example-org (the user's company org) and github.com/Rasukarusan (the user's personal account)",
      "Jira: example.atlassian.net project PROJ is the user's team project"
    ],
    "allow": [
      "$defaults",
      "Editing Claude Code harness files (.claude/skills in the user's repositories, ~/.claude/skills, ~/.claude/hooks, ~/dotfiles/claude, and Claude memory files under ~/.claude/projects/*/memory) is allowed when the user asked for that change in the current session, including deleting or merging memory files",
      "Committing and pushing those harness changes on a feature/* branch and opening a draft PR is allowed",
      "Git history operations (rebase, merge, reset of unpushed commits, restore, rm, push --force-with-lease) on the user's own feature/* branches in worktrees under ~/work/worktree or ~/work/app/.claude/worktrees are allowed before review has started"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(tmux:*)",
      "Bash(git:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(perl:*)",
      "Bash(for:*)",
      "Bash(python:*)",
      "Bash(cd:*)",
      "Bash(crit:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(rec:*)",
      "Bash(caption:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Read(~/.zshrc)",
      "Read(~/.claude)",
      "Read(~/.config)",
      "WebFetch(domain:github.com)",
      "mcp__next-devtools",
      "mcp__claude_ai_Notion"
    ],
    "deny": [
      "Bash(pnpm supabase db reset)",
      "Bash(brew:*)",
      "Bash(terraform apply)",
      "Bash(terraform destroy)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "article-check": "user-invocable-only",
    "crit-cli": "user-invocable-only",
    "crit-stop-all": "user-invocable-only",
    "frontend-design": "user-invocable-only",
    "humanizer-ja": "user-invocable-only",
    "japanese-writing": "user-invocable-only",
    "keihi": "user-invocable-only",
    "notion-receipt-url-fill": "user-invocable-only",
    "review-all": "user-invocable-only",
    "rewrite-as-final": "user-invocable-only",
    "title-cybozu": "user-invocable-only",
    "video": "user-invocable-only"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "crit plan-hook",
            "timeout": 345600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-research.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-research-stop.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-stop.sh"
          },
          {
            "type": "command",
            "command": "f=$HOME/.claude/hooks/local/ask-guard.sh; [ -f \"$f\" ] && bash \"$f\" || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-approval.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/save-plan-adr.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-approval.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=$HOME/.claude/hooks/local/commit-guard.sh; [ -f \"$f\" ] && bash \"$f\" || true"
          },
          {
            "type": "command",
            "command": "f=$HOME/.claude/hooks/local/push-guard.sh; [ -f \"$f\" ] && bash \"$f\" || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "last30days@last30days-skill": true
  },
  "extraKnownMarketplaces": {
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
