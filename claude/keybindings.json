{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "ctrl+w w": "abovePrompt:focus",
        "ctrl+w ctrl+w": "abovePrompt:focus"
      }
    },
    {
      "context": "AbovePrompt",
      "bindings": {
        "ctrl+w w": "abovePrompt:leave",
        "ctrl+w ctrl+w": "abovePrompt:leave"
      }
    }
  ]
}
