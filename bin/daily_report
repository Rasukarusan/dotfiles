#!/bin/sh

#
# Chromeの閲覧履歴・Claude Codeのセッション・Codexのセッションを読み取り、
# その日に何をしていたかを claude -p で日報風にまとめるスクリプト
#
# [使い方]
#   ▶day                             活動のある日付をfzfで選んで要約(Tabで複数選択)
#   ▶day 2026-10-23                  指定日を要約(fzfをスキップ)
#   ▶day "口語で"                    追加指示つきで要約(日付はfzfで選択)
#   ▶day 2026-10-23 "Slack投稿用に"  指定日+追加指示
#   ▶day 2026-10-22 2026-10-23       複数日を指定
#   ▶day -f 2026-10-23               キャッシュを無視して作り直す
#   ▶day -r 2026-10-23               要約せず、claude -p に渡す素材をそのまま出力する
#
# [仕組み]
# 指定日(JST)について、次の3つから素材を集めて claude -p に渡す。
#   - Claude Code: ~/.claude/projects/*/<session>.jsonl の手入力した発言(worktreeのセッションも含む)
#   - Codex      : ~/.codex/history.jsonl の手入力した発言。cwd/branchは sessions/ のrollout、
#                  タイトルは session_index.jsonl から引く
#   - Chrome     : 全プロファイルの History の visits(訪問ごとの記録)
# 生成した日報は ~/.cache/daily_report/<日付>.md に保存し、次回からはそれを表示する。
# 追加指示つきの実行はキャッシュを読み書きしない。
# 複数の日付を選んだ場合は各日の日報を並列に作り、日付順に並べて最後に日付ごとの見出し一覧を付ける。
#

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/daily_report"

show() {
    if command -v glow >/dev/null 2>&1; then
        glow -
    else
        cat
    fi
}

# collect dates            : 活動のある日付の一覧(fzf用)を出す
# collect material <日付>  : 指定日の素材を出す。何も無ければ2で終わる
collect() {
    python3 - "$CACHE_DIR" "$@" <<'PY'
import sys, os, json, glob, sqlite3, subprocess
from datetime import datetime, timezone, timedelta
from collections import Counter, defaultdict
from urllib.parse import urlparse, quote

cache_dir, mode = sys.argv[1], sys.argv[2]
target_date = sys.argv[3] if len(sys.argv) > 3 else None
HOME = os.path.expanduser('~')
JST = timezone(timedelta(hours=9))
CLAUDE_PROJECTS = os.path.join(HOME, '.claude', 'projects')
CODEX_HOME = os.environ.get('CODEX_HOME') or os.path.join(HOME, '.codex')
CHROME_DIR = os.path.join(HOME, 'Library', 'Application Support', 'Google', 'Chrome')
CHROME_EPOCH = datetime(1601, 1, 1, tzinfo=timezone.utc)

def iso_to_jst(ts):
    try:
        return datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(JST)
    except Exception:
        return None

def clean(text, limit=300):
    text = ' '.join(text.split())
    return text[:limit] + '…' if len(text) > limit else text

def read_jsonl(path):
    try:
        with open(path, encoding='utf-8') as fh:
            for line in fh:
                try:
                    yield json.loads(line)
                except Exception:
                    continue
    except Exception:
        return

# worktreeのcwdを本体のリポジトリ名に寄せる。worktreeが残っていれば .git ファイルの gitdir から、
# 消えていれば /x/repo/.claude/worktrees/foo や /x/worktree/repo/foo のパスから推測する
def repo_name(cwd):
    if not cwd:
        return '?'
    try:
        with open(os.path.join(cwd, '.git'), encoding='utf-8') as fh:
            gitdir = fh.read().strip().removeprefix('gitdir: ')
        if '/.git/worktrees/' in gitdir:
            return os.path.basename(gitdir.split('/.git/worktrees/')[0])
    except Exception:
        pass
    if '/.claude/worktrees/' in cwd:
        return repo_name(cwd.split('/.claude/worktrees/')[0])
    parts = cwd.split('/')
    if 'worktree' in parts:
        i = parts.index('worktree')
        if i + 1 < len(parts):
            return parts[i + 1]
    return os.path.basename(cwd.rstrip('/')) or cwd

def label(cwd, branch):
    name = repo_name(cwd)
    return f'{name} ({branch})' if branch and branch not in ('HEAD', '-') else name

# ---- Claude Code ----
def claude_prompts():
    """(session_path, datetime, text, cwd, branch) を返す。手入力した発言だけ"""
    # 全行をjson.loadsすると数秒かかるので、人の発言の行だけをripgrepで先に抜き出す
    rg = subprocess.run(
        ['rg', '--null', '--with-filename', '--no-messages', '-F', '"kind":"human"',
         '--max-depth', '2', '-g', '*.jsonl', CLAUDE_PROJECTS],
        capture_output=True, text=True)
    for row in rg.stdout.splitlines():
        path, _, line = row.partition('\0')
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get('type') != 'user' or (d.get('origin') or {}).get('kind') != 'human':
            continue
        content = (d.get('message') or {}).get('content')
        if not isinstance(content, str):
            continue
        text = content.strip()
        if not text or text.startswith('<'):
            continue
        dt = iso_to_jst(d.get('timestamp') or '')
        if dt:
            yield path, dt, text, d.get('cwd'), d.get('gitBranch')

def claude_title(path):
    title = custom = None
    for d in read_jsonl(path):
        if d.get('type') == 'ai-title':
            title = d.get('aiTitle') or title
        elif d.get('type') == 'custom-title':
            custom = d.get('customTitle') or custom
    return custom or title

# ---- Codex ----
def codex_prompts():
    """(session_id, datetime, text) を返す。history.jsonl は手入力した発言だけを持つ"""
    for d in read_jsonl(os.path.join(CODEX_HOME, 'history.jsonl')):
        text = (d.get('text') or '').strip()
        if not text or not d.get('ts'):
            continue
        yield d.get('session_id'), datetime.fromtimestamp(d['ts'], JST), text

def codex_meta(session_ids):
    """session_id -> (cwd, branch, title)"""
    titles = {}
    for d in read_jsonl(os.path.join(CODEX_HOME, 'session_index.jsonl')):
        if d.get('id') and d.get('thread_name'):
            titles[d['id']] = d['thread_name']
    meta = {}
    for sid in session_ids:
        cwd = branch = None
        for path in glob.glob(os.path.join(CODEX_HOME, 'sessions', '*', '*', '*', f'rollout-*-{sid}.jsonl')):
            for d in read_jsonl(path):
                if d.get('type') == 'session_meta':
                    p = d.get('payload') or {}
                    cwd, branch = p.get('cwd'), (p.get('git') or {}).get('branch')
                break
        meta[sid] = (cwd, branch, titles.get(sid))
    return meta

# ---- Chrome ----
def chrome_dbs():
    for path in glob.glob(os.path.join(CHROME_DIR, '*', 'History')):
        # Chrome起動中はロックされているので immutable で読む
        uri = 'file:' + quote(path) + '?immutable=1'
        try:
            yield sqlite3.connect(uri, uri=True)
        except Exception:
            continue

def chrome_time(us):
    return (CHROME_EPOCH + timedelta(microseconds=us)).astimezone(JST)

def to_chrome_us(dt):
    return int((dt - CHROME_EPOCH).total_seconds() * 1_000_000)

def chrome_visits(start=None, end=None):
    """(datetime, title, url) を返す"""
    sql = 'SELECT v.visit_time, u.title, u.url FROM visits v JOIN urls u ON u.id = v.url'
    args = ()
    if start is not None:
        sql += ' WHERE v.visit_time >= ? AND v.visit_time < ?'
        args = (to_chrome_us(start), to_chrome_us(end))
    for con in chrome_dbs():
        try:
            for us, title, url in con.execute(sql, args):
                yield chrome_time(us), title or '', url or ''
        except Exception:
            pass
        finally:
            con.close()

WD = '月火水木金土日'

if mode == 'dates':
    counts = defaultdict(Counter)
    for _, dt, *_ in claude_prompts():
        counts[dt.strftime('%Y-%m-%d')]['claude'] += 1
    for _, dt, _ in codex_prompts():
        counts[dt.strftime('%Y-%m-%d')]['codex'] += 1
    for dt, _, _ in chrome_visits():
        counts[dt.strftime('%Y-%m-%d')]['chrome'] += 1
    for day in sorted(counts, reverse=True):
        c = counts[day]
        wd = WD[datetime.strptime(day, '%Y-%m-%d').weekday()]
        cached = '  (キャッシュ済)' if os.path.exists(os.path.join(cache_dir, day + '.md')) else ''
        print(f"{day}（{wd}）\tclaude {c['claude']:>3}  codex {c['codex']:>3}  chrome {c['chrome']:>4}{cached}")
    sys.exit(0)

out = []

# Claude: セッションごとに発言を並べる
sessions = defaultdict(list)
where = {}
for path, dt, text, cwd, branch in claude_prompts():
    if dt.strftime('%Y-%m-%d') != target_date:
        continue
    sessions[path].append((dt, clean(text)))
    where[path] = (cwd, branch)
if sessions:
    out.append('# Claude Code のセッション\n')
    for path in sorted(sessions, key=lambda p: min(sessions[p])):
        out.append(f"## [{label(*where[path])}] {claude_title(path) or '(無題)'}")
        out += [f"- {dt:%H:%M} {text}" for dt, text in sorted(sessions[path])]
        out.append('')

# Codex: セッションごとに発言を並べる
csessions = defaultdict(list)
for sid, dt, text in codex_prompts():
    if dt.strftime('%Y-%m-%d') == target_date:
        csessions[sid].append((dt, clean(text)))
if csessions:
    meta = codex_meta(csessions)
    out.append('# Codex のセッション\n')
    for sid in sorted(csessions, key=lambda s: min(csessions[s])):
        cwd, branch, title = meta[sid]
        out.append(f"## [{label(cwd, branch)}] {title or '(無題)'}")
        out += [f"- {dt:%H:%M} {text}" for dt, text in sorted(csessions[sid])]
        out.append('')

# Chrome: 時系列に並べ、同じページを10分以内に再訪したもの(タブの行き来など)は省く
day_start = datetime.strptime(target_date, '%Y-%m-%d').replace(tzinfo=JST)
visits = sorted(chrome_visits(day_start, day_start + timedelta(days=1)))
lines, last_seen = [], {}
for dt, title, url in visits:
    host = urlparse(url).hostname or ''
    if url.startswith(('chrome://', 'chrome-extension://')) or not (title or host):
        continue
    key = title or url
    seen = last_seen.get(key)
    last_seen[key] = dt
    if seen and dt - seen < timedelta(minutes=10):
        continue
    lines.append(f"- {dt:%H:%M} {clean(title or url, 120)} ({host})")
MAX_CHROME = 800
if len(lines) > MAX_CHROME:
    # 多すぎる日は均等に間引く
    step = len(lines) / MAX_CHROME
    lines = [lines[int(i * step)] for i in range(MAX_CHROME)]
if lines:
    out.append('# Chrome の閲覧履歴(時刻 タイトル (ドメイン))\n')
    out += lines
    out.append('')

if not out:
    sys.exit(2)
print('\n'.join(out))
PY
}

FORCE=0
RAW=0
while :; do
    case "${1:-}" in
        -f) FORCE=1; shift ;;
        -r) RAW=1; shift ;;
        *) break ;;
    esac
done

# 先頭のYYYY-MM-DD形式の引数は日付(複数可)、それ以外の引数は追加指示として扱う
TARGET_DATES=""
while echo "${1:-}" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; do
    TARGET_DATES=$(printf '%s\n%s' "$TARGET_DATES" "$1" | sed '/^$/d')
    shift
done
TARGET_DATES=$(echo "$TARGET_DATES" | sort -u)
EXTRA_INSTRUCTION="$*"

if [ -z "$TARGET_DATES" ]; then
    selected=$(collect dates | fzf --popup 80% --multi --prompt='日報を出す日付(Tabで複数選択)> ')
    [ -z "$selected" ] && exit 0
    TARGET_DATES=$(echo "$selected" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}' | sort)
fi

if [ "$RAW" -eq 1 ]; then
    for date in $TARGET_DATES; do
        collect material "$date"
    done
    exit 0
fi

# 2026-10-23 → 2026-10-23（金）
date_label() {
    wd=$(date -j -f '%Y-%m-%d' "$1" '+%u')
    echo "$1（$(echo '月 火 水 木 金 土 日' | cut -d ' ' -f "$wd")）"
}

# 指定日の日報(末尾に見出し一覧つき)を標準出力に出す。活動が無い日は2を返す
daily_report() {
    TARGET_DATE="$1"
    CACHE_FILE="$CACHE_DIR/$TARGET_DATE.md"
    if [ -z "$EXTRA_INSTRUCTION" ] && [ "$FORCE" -eq 0 ] && [ -s "$CACHE_FILE" ]; then
        echo "📄 キャッシュを使います(作り直すなら day -f $TARGET_DATE): $CACHE_FILE" 1>&2
        cat "$CACHE_FILE"
        return 0
    fi

    material=$(collect material "$TARGET_DATE")
    status=$?
    if [ "$status" -eq 2 ]; then
        echo "$TARGET_DATE の活動記録は見つかりませんでした。" 1>&2
        return 2
    elif [ "$status" -ne 0 ]; then
        echo "活動記録の抽出に失敗しました。" 1>&2
        return 1
    fi

    echo "🤖 $TARGET_DATE の活動を要約中..." 1>&2

    prompt="以下は私の $TARGET_DATE の活動記録です。次の3種類があります(無い種類もあります)。
- Claude Code / Codex のセッション: '## [リポジトリ (ブランチ)] タイトル' と、その下に時刻付きの私の指示(発言)
- Chrome の閲覧履歴: 時刻・ページタイトル・ドメイン
これらを突き合わせて、その日に何をしていたかを推測し、日報風にまとめてください。

- 出力は必ずMarkdown形式にする
- 冒頭に '## 概要' として、その日の主な成果を3行以内の箇条書きで書く
- 続けて作業テーマ(リポジトリ・チケット・調べ物など)ごとにグルーピングし、'## 見出し' を付ける
- 見出しには、その作業をしていたおおよその時間帯を '(10:00〜12:30)' のように添える
- 各項目は '- ' から始まる箇条書きで1行ずつ簡潔に
- 単なる指示やページ名の引き写しではなく「何を実現/前進させたか」「何を調べたか」として書く
- AIセッションと閲覧履歴が同じ作業に関係していれば(PR・チケット・ドキュメントなど)、同じ見出しにまとめる
- 作業と関係の薄い閲覧(ニュース・SNS・動画など)は最後に '## その他' として軽くまとめる
- 前置きや締めの文章は不要。Markdownの本文だけを出力する"

    if [ -n "$EXTRA_INSTRUCTION" ]; then
        prompt="$prompt

--- 追加指示(最優先で従うこと) ---
$EXTRA_INSTRUCTION"
    fi

    # 素材は大きくなるので引数ではなく標準入力で渡す
    report=$(printf '%s\n\n--- 活動記録 ---\n%s\n' "$prompt" "$material" | claude -p) || return 1
    headings=$(printf '%s\n' "$report" | sed -n 's/^## *//p' | sed 's/^/- /')
    if [ -n "$headings" ]; then
        report=$(printf '%s\n\n---\n\n%s' "$report" "$headings")
    fi

    if [ -z "$EXTRA_INSTRUCTION" ]; then
        mkdir -p "$CACHE_DIR"
        printf '%s\n' "$report" > "$CACHE_FILE"
    fi

    printf '%s\n' "$report"
}

count=$(echo "$TARGET_DATES" | wc -l | tr -d ' ')

if [ "$count" -eq 1 ]; then
    report=$(daily_report "$TARGET_DATES") || exit 0
    printf '%s\n' "$report" | show
    exit 0
fi

# 複数日: 各日の日報を並列に作り、揃ったら日付順に並べて最後に日付ごとの見出し一覧を出す
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT
for date in $TARGET_DATES; do
    daily_report "$date" > "$WORK_DIR/$date.md" || rm -f "$WORK_DIR/$date.md" &
done
wait

body=""
summary=""
for date in $TARGET_DATES; do
    [ -f "$WORK_DIR/$date.md" ] || continue
    report=$(cat "$WORK_DIR/$date.md")
    label=$(date_label "$date")
    # 日報末尾の見出し一覧(--- 以降)は最後のまとめと重なるので外す
    body="$body# $label

$(printf '%s\n' "$report" | sed '/^---$/,$d')

"
    summary="$summary## $label

$(printf '%s\n' "$report" | sed -n 's/^## *//p' | sed 's/^/- /')

"
done

[ -z "$summary" ] && exit 0
printf '%s---\n\n%s' "$body" "$summary" | show
