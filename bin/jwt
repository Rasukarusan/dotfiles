#!/usr/bin/env bash
#
# 入力に含まれる JWT を header と payload にデコードして表示する。署名は検証しない。
#
#   jwt               クリップボードから読む
#   jwt <token>
#   ... | jwt
#
# 入力が JSON なら JWT が入っているキーを、それ以外のテキストなら出現順を見出しにして、
# JWT ごとに分けて表示する。JWT が 1 つだけなら見出しは付けない。
# exp / iat / nbf / auth_time はローカル時刻に変換して併記し、exp 切れなら expired を付ける。

set -euo pipefail

if [ $# -gt 0 ]; then
  input=$1
elif [ -t 0 ]; then
  input=$(pbpaste)
else
  input=$(cat)
fi

if ! grep -qE 'eyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]+\.' <<<"$input"; then
  echo "jwt: JWT が見つかりません" >&2
  exit 1
fi

# 1 行に 1 つ {label, decoded} を出す
entries=$(printf %s "$input" | jq -R -s -c '
  def jwt_pattern: "eyJ[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*";
  def is_jwt: type == "string" and test("^" + jwt_pattern + "$");

  # base64url をパディング付きの base64 に戻してデコードする
  def b64url_decode:
    gsub("-"; "+") | gsub("_"; "/")
    | . + ("=" * ((4 - length % 4) % 4))
    | @base64d | fromjson;

  def annotate_times:
    now as $now
    | with_entries(
        if (.key | IN("exp", "iat", "nbf", "auth_time")) and (.value | type) == "number" then
          .value = "\(.value) (\(.value | strflocaltime("%Y-%m-%d %H:%M:%S %Z"))\(if .key == "exp" and .value < $now then ", expired" else "" end))"
        else . end
      );

  def decode_jwt:
    split(".") | {header: (.[0] | b64url_decode), payload: (.[1] | b64url_decode | annotate_times)};

  # ["a", 0, "b"] -> "a[0].b"
  def path_label:
    map(if type == "number" then "[\(.)]" else ".\(.)" end) | join("") | ltrimstr(".");

  . as $text
  | (try fromjson catch null) as $json
  | if ($json | type) == "object" or ($json | type) == "array" then
      $json | paths(is_jwt) as $p | {label: ($p | path_label), decoded: (getpath($p) | decode_jwt)}
    else
      [$text | scan(jwt_pattern)] | to_entries[] | {label: "#\(.key + 1)", decoded: (.value | decode_jwt)}
    end
')

count=$(wc -l <<<"$entries")
first=1
while IFS= read -r entry; do
  if [ "$count" -gt 1 ]; then
    [ $first -eq 1 ] || echo
    label=$(jq -r .label <<<"$entry")
    if [ -t 1 ]; then
      printf '\033[1;36m== %s ==\033[0m\n' "$label"
    else
      printf '== %s ==\n' "$label"
    fi
  fi
  jq .decoded <<<"$entry"
  first=0
done <<<"$entries"
