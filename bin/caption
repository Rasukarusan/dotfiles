#!/usr/bin/env bash
set -euo pipefail

# 画面に字幕オーバーレイを表示する(画面録画の実況・E2E動作確認動画用)。
# 本体は bin/claude-caption/ の Swift アプリ。未起動なら自動起動する。
#
# 番号で複数の字幕を出し分ける。既定は1番。
# 字幕はドラッグで移動でき、移動先は表示している間だけ番号ごとに記憶される。
# 消すと位置も忘れるので、次に出したときは既定位置から始まる。
# クリックするとその場で文字を編集できる(Shift+Enterで改行、Enter・Escape・外をクリックで確定)。
# 編集中は左上に番号、右上に × が出る。× を押すとその字幕だけ消える。
#
# 使い方:
#   caption "ログイン画面です"    # 空いている番号に新しく足す(番号を考えなくてよい)
#   caption 2 "こっちが変更後"    # 2番の文言を差し替える(無ければ2番に作る)
#   caption --hide 2              # 2番を消す
#   caption --hide                # 全部消す
#   caption --reset 2             # 2番の位置を既定に戻す(番号省略で全部)
#   caption --list                # 表示中の字幕を一覧
#   caption --quit                # アプリを終了
#
# 字幕ごとのオプション(番号の後、テキストの前に置く。指定した内容は消すまで残る):
#   --pos <位置>   bottom(既定) / top / center / top-left / top-right
#                  / bottom-left / bottom-right
#   --alpha <0-1>  文字の不透明度。薄くして脇役にする
#   --color <色>   文字色 ("#RRGGBB")
#
# 行頭に `>` を付けた行だけは --alpha を無視して不透明で出る。
# 全体フローを薄く出しつつ、今いる行だけをはっきり見せるのに使う:
#
#   caption 2 --pos top-right --alpha 0.4 "① ログイン画面
#   > ② ログインする
#   ③ ダッシュボードを確認"
#   caption 1 "② ログインボタンを押します"
#
# 先頭が数字のテキストを1番に出したいときは `caption 1 2024年の画面` のように番号を明示する。
#
# 全体の既定値は環境変数で変えられる(アプリ起動時に読むので --quit してから指定する):
#   CAPTION_FONT_SIZE=32          文字の大きさ
#   CAPTION_COLOR="#FFFFFF"       字幕の文字色
#   CAPTION_BADGE_COLOR="#00E5FF" 左上の番号の色

STATE_DIR="/tmp/claude-caption"
APP="$HOME/.local/bin/claude-caption"

die() {
  echo "error: $*" >&2
  exit 1
}

valid_slot() {
  [[ $1 =~ ^[0-9]+$ ]] || die "番号は数字で指定してください: $1"
}

# 消えた字幕の状態(文言・位置・見た目)は残さない。次に出すときは既定から始める
hide_slot() {
  rm -f "$STATE_DIR/$1".{txt,xy,alpha,color,pos}
}

hide_all() {
  shopt -s nullglob
  rm -f "$STATE_DIR"/*
}

# 番号の後ろに置かれた見た目のオプションを読み、残りをテキストとして返す
STYLE_ARGS=()
parse_style() {
  STYLE_ARGS=()
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --pos)
        [[ ${2:-} =~ ^(bottom|top|center|top-left|top-right|bottom-left|bottom-right)$ ]] ||
          die "--pos の指定が不正です: ${2:-}"
        STYLE_ARGS+=("pos:$2")
        ;;
      --alpha)
        [[ ${2:-} =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || die "--alpha は 0〜1 で指定してください: ${2:-}"
        STYLE_ARGS+=("alpha:$2")
        ;;
      --color)
        [[ ${2:-} =~ ^#?[0-9A-Fa-f]{6}$ ]] || die "--color は #RRGGBB で指定してください: ${2:-}"
        STYLE_ARGS+=("color:$2")
        ;;
      *) die "不明なオプションです: $1" ;;
    esac
    shift 2
  done
  REST=("$@")
}

write_style() {
  local slot=$1
  for entry in ${STYLE_ARGS+"${STYLE_ARGS[@]}"}; do
    printf '%s' "${entry#*:}" >"$STATE_DIR/$slot.${entry%%:*}"
  done
}

launch_if_needed() {
  pgrep -xq claude-caption 2>/dev/null && return 0
  [[ -x $APP ]] || die "$APP がありません。bin/claude-caption/build.sh を実行してください"
  nohup "$APP" >/dev/null 2>&1 &
}

mkdir -p "$STATE_DIR"

case "${1:-}" in
  --quit)
    pkill -x claude-caption 2>/dev/null || true
    rm -rf "$STATE_DIR"
    exit 0
    ;;
  --list)
    shopt -s nullglob
    found=0
    for f in "$STATE_DIR"/*.txt; do
      slot=$(basename "$f" .txt)
      [[ -s $f ]] || continue
      found=1
      printf '%s: %s\n' "$slot" "$(cat "$f")"
    done
    (( found )) || echo "表示中の字幕はありません"
    exit 0
    ;;
  --hide)
    shift
    if [[ -n ${1:-} ]]; then
      valid_slot "$1"
      hide_slot "$1"
    else
      hide_all
    fi
    exit 0
    ;;
  --reset)
    shift
    if [[ -n ${1:-} ]]; then
      valid_slot "$1"
      rm -f "$STATE_DIR/$1.xy"
    else
      shopt -s nullglob
      rm -f "$STATE_DIR"/*.xy
    fi
    exit 0
    ;;
  "")
    hide_all
    exit 0
    ;;
esac

slot=""
if [[ $1 =~ ^[0-9]+$ ]]; then
  slot=$1
  shift
fi

parse_style "$@"
set -- ${REST+"${REST[@]}"}

if [[ $# -eq 0 ]]; then
  [[ -n $slot ]] || die "番号かテキストを指定してください"
  # オプションだけを渡した場合は見た目の変更として扱い、字幕は消さない
  if [[ ${#STYLE_ARGS[@]} -gt 0 ]]; then
    write_style "$slot"
    exit 0
  fi
  hide_slot "$slot"
  exit 0
fi

# 番号を省いたら新しい字幕として空いている番号に足す
added=""
if [[ -z $slot ]]; then
  slot=1
  while [[ -s "$STATE_DIR/$slot.txt" ]]; do slot=$((slot + 1)); done
  added=1
fi

write_style "$slot"
printf '%s' "$*" >"$STATE_DIR/$slot.txt"
launch_if_needed
[[ -n $added ]] && echo "${slot}番に表示しました"
exit 0
