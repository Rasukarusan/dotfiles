#!/usr/bin/env bash
#
# 今のブランチの PR のレビューコメントを取得して整形表示する。
#
# 除外するスレッド(/pr-comments コマンドの条件と同じ):
#   - Resolved 済み
#   - eslint など bot のコメント(author が *[bot] / 本文に eslint を含む)
#   - スレッドの最初または最後が PR 作者(レビュイー)のコメント
# 残ったスレッドに #1 から通し番号を振る。この番号が Claude 側(/pr-comments)と
# tmux の右上ペイン表示で共通の「正」になるよう、両方ともこのスクリプトを使う。
#
# 使い方:
#   pr-comments           一覧を標準出力へ(Claude / シェルから)
#   pr-comments --view    右上ペインの中身として一覧を表示し続ける(q で閉じる)
#   pr-comments --pane    tmux の右上にペインを作って表示(既存があれば内容を更新)
#
# tmux.conf:
#   bind '*' run-shell 'pr-comments --pane #{pane_id}'
set -euo pipefail

# 右上ペインの幅(tmux の -l に渡す)
PANE_WIDTH="${PR_COMMENTS_PANE_WIDTH:-40%}"
# ペイン id を覚えておく window オプション名
PANE_OPT='@pr_comments_pane'

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

read -r -d '' QUERY <<'GQL' || true
query($owner: String!, $repo: String!, $number: Int!) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      number
      title
      url
      author { login }
      reviewThreads(first: 100) {
        nodes {
          isResolved
          path
          line
          originalLine
          comments(first: 50) {
            nodes {
              body
              createdAt
              url
              author { login }
            }
          }
        }
      }
    }
  }
}
GQL

read -r -d '' FORMAT <<'JQ' || true
def body_lines: (. // "") | gsub("\r"; "") | sub("\n+$"; "") | split("\n") | map("    " + .) | join("\n");
def at($t): ($t.line // $t.originalLine) as $l | if $l == null then "" else ":\($l)" end;

.data.repository.pullRequest as $pr
| ($pr.author.login // "") as $reviewee
| [ $pr.reviewThreads.nodes[]
    | select(.isResolved | not)
    | select((.comments.nodes | length) > 0)
    | select((.comments.nodes[0].author.login // "") != $reviewee)
    | select((.comments.nodes[-1].author.login // "") != $reviewee)
    | select(((.comments.nodes[0].author.login // "") | test("\\[bot\\]$")) | not)
    | select(((.comments.nodes[0].body // "") | test("eslint"; "i")) | not)
  ] as $threads
| "\($c_head)PR #\($pr.number) \($pr.title)\($c_off)",
  "\($c_dim)\($pr.url)  /  未対応コメント \($threads | length) 件  (取得 \($now))\($c_off)",
  "",
  ( if ($threads | length) == 0 then
      "対応が必要なコメントはありません。"
    else
      ( $threads
        | to_entries
        | map(
            (.key + 1) as $n
            | .value as $t
            | "\($c_head)#\($n) \($t.path)\(at($t))\($c_off)\n"
              + ( $t.comments.nodes
                  | map("  \($c_user)@\(.author.login // "unknown")\($c_off) \($c_dim)\(.createdAt | sub("T"; " ") | .[0:16])\($c_off)\n"
                        + (.body | body_lines))
                  | join("\n\n") )
              + "\n  \($c_dim)\($t.comments.nodes[0].url)\($c_off)"
          )
        | join("\n\n") )
    end )
JQ

# 一覧を組み立てて標準出力へ。取得できない場合は理由を出して終了コード 1。
render() {
  local color=$1 num json err
  local c_head='' c_user='' c_dim='' c_off=''
  if [ "$color" = 1 ]; then
    c_head=$'\033[1;36m'
    c_user=$'\033[1;33m'
    c_dim=$'\033[90m'
    c_off=$'\033[0m'
  fi

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "git リポジトリではありません: $PWD"
    return 1
  fi
  if ! num="$(gh pr view --json number --jq .number 2>&1)"; then
    err="$num"
    echo "PR を取得できません: ${err%%$'\n'*}"
    return 1
  fi
  if ! json="$(gh api graphql -F owner='{owner}' -F repo='{repo}' -F number="$num" -f query="$QUERY" 2>&1)"; then
    echo "コメントを取得できません: ${json%%$'\n'*}"
    return 1
  fi

  printf '%s\n' "$json" | jq -r \
    --arg c_head "$c_head" --arg c_user "$c_user" --arg c_dim "$c_dim" --arg c_off "$c_off" \
    --arg now "$(date '+%m/%d %H:%M')" \
    "$FORMAT"
}

# 右上ペインの中身。q で閉じ、それ以外のキーで取り直す。
view() {
  local key
  while true; do
    clear
    render 1 || true
    printf '\n\033[90m-- q:閉じる / 他のキー:取り直す (prefix+* でも取り直せる)\033[0m\n'
    IFS= read -r -s -n 1 key || break
    case "$key" in
      q | Q) break ;;
    esac
  done
}

# tmux の右上にペインを作る。既にあれば同じペインで中身を作り直す。
open_pane() {
  local src=$1 win cwd pane
  case "$src" in
    "" | *'#{'*) src="$(tmux display-message -p '#{pane_id}')" ;;
  esac
  win="$(tmux display-message -p -t "$src" '#{session_name}:#{window_index}')"
  cwd="$(tmux display-message -p -t "$src" '#{pane_current_path}')"

  pane="$(tmux show-option -w -q -v -t "$win" "$PANE_OPT" 2>/dev/null || true)"
  if [ -n "$pane" ] && tmux list-panes -t "$win" -F '#{pane_id}' | grep -qx -- "$pane"; then
    tmux respawn-pane -k -t "$pane" -c "$cwd" "$SELF --view"
    return
  fi

  pane="$(tmux split-window -d -h -l "$PANE_WIDTH" -t "$win.{top-right}" -c "$cwd" \
    -P -F '#{pane_id}' "$SELF --view")"
  tmux set-option -w -t "$win" "$PANE_OPT" "$pane"
}

case "${1:-}" in
  --pane)
    open_pane "${2:-}"
    ;;
  --view)
    # ペインの中身。ページャは使わず素のまま流し、スクロールは tmux の copy-mode に任せる。
    # 取得に失敗してもペインを落とさず、理由を出したまま留まる。
    view
    ;;
  "" | --plain)
    render 0
    ;;
  -h | --help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"
    ;;
  *)
    echo "unknown option: $1" >&2
    exit 2
    ;;
esac
