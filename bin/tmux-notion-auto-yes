#!/usr/bin/env python3
import fcntl
import hashlib
import os
import re
import subprocess
import tempfile
import time


def approval(screen):
    lines = [line.strip() for line in screen.rstrip().splitlines()]
    text = "\n".join(lines)
    headings = list(re.finditer(r"(?m)^About the (.+):\s*$", text))
    if not headings:
        return False
    heading = headings[-1]
    if not re.match(r"Notion\s*[-–—]\s*Notion-", heading[1]):
        return False
    dialog = text[heading.end():]
    return bool(re.search(
        r"Your organization requires approval for this tool\s+"
        r"Do you want to proceed\?\s+"
        r"[❯>›]?\s*1\. Yes\s+2\. No\s+"
        r"Esc to cancel[^\n]*\Z", dialog
    ))


def main():
    socket = os.environ.get("TMUX", "").split(",")[0]
    if not socket:
        return
    key = hashlib.sha256(socket.encode()).hexdigest()[:20]
    lock_path = os.path.join(tempfile.gettempdir(), f"tmux-notion-{os.getuid()}-{key}.lock")
    with open(lock_path, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return

        def tmux(*args):
            return subprocess.run(
                ["tmux", "-S", socket, *args], capture_output=True, text=True,
                timeout=5, check=True,
            ).stdout

        sent = {}
        while True:
            try:
                if tmux("show-option", "-gqv", "@notion-auto-yes").strip() != "on":
                    sent.clear()
                    time.sleep(1)
                    continue
                panes = tmux("list-panes", "-a", "-F", "#{pane_id}\t#{pane_in_mode}\t#{pane_tty}\t#{pane_synchronized}")
                live = set()
                for row in panes.splitlines():
                    pane, mode, tty, synchronized = row.split("\t")
                    live.add(pane)
                    if mode != "0" or synchronized == "1":
                        continue
                    commands = subprocess.run(
                        ["ps", "-t", tty.removeprefix("/dev/"), "-o", "comm="],
                        capture_output=True, text=True, timeout=5,
                    ).stdout
                    if not any(os.path.basename(c.strip()) == "claude" for c in commands.splitlines()):
                        sent.pop(pane, None)
                        continue
                    screen = tmux("capture-pane", "-p", "-t", pane)
                    if not approval(screen):
                        sent.pop(pane, None)
                        continue
                    if sent.get(pane) != screen:
                        time.sleep(0.15)
                        if tmux("capture-pane", "-p", "-t", pane) == screen:
                            tmux("send-keys", "-t", pane, "1", "Enter")
                            sent[pane] = screen
                sent = {pane: screen for pane, screen in sent.items() if pane in live}
            except subprocess.CalledProcessError:
                return
            except subprocess.TimeoutExpired:
                pass
            time.sleep(1)


if __name__ == "__main__":
    main()
