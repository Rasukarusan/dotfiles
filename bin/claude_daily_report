#!/bin/sh

#
# Claude Code の「その日触ったセッション」を読み取り、claude -p で日報風に要約するスクリプト
#
# [使い方]
#   ▶clds                             セッションのある日付をfzfで選んで要約(Tabで複数選択)
#   ▶clds 2026-06-24                  指定日のセッションを要約(fzfをスキップ)
#   ▶clds "口語で"                    追加指示つきで要約(日付はfzfで選択)
#   ▶clds 2026-06-24 "Slack投稿用に"  指定日+追加指示
#   ▶clds 2026-06-23 2026-06-24       複数日を指定
#   ▶clds -f 2026-06-24               キャッシュを無視して作り直す
#
# [仕組み]
# ~/.claude/projects/<プロジェクト>/<session>.jsonl から、指定日(JST)に入力した
# ユーザー発言(typed)とセッションのAIタイトルを抽出し、claude -p に渡して日報を生成する。
# 出力はMarkdownなのでglowで整形して表示する(glowが無ければ素の出力)。
# 日報の末尾には、日報の見出し(## 〜)だけを箇条書きにした一覧を付ける。
# 生成した日報は ~/.cache/claude_daily_report/<日付>.md に保存し、次回からはそれを表示する。
# 追加指示つきの実行はキャッシュを読み書きしない。
# 複数の日付を選んだ場合は各日の日報を並列に作って日付順に並べ、最後に日付ごとの見出し一覧を付ける。
#

PROJECTS_DIR="$HOME/.claude/projects"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude_daily_report"

show() {
    if command -v glow >/dev/null 2>&1; then
        glow -
    else
        cat
    fi
}

FORCE=0
if [ "${1:-}" = "-f" ]; then
    FORCE=1
    shift
fi

if [ ! -d "$PROJECTS_DIR" ]; then
    echo "Claudeのプロジェクトディレクトリが見つかりません: $PROJECTS_DIR" 1>&2
    exit 1
fi

# 先頭のYYYY-MM-DD形式の引数は日付(複数可)、それ以外の引数は追加指示として扱う
TARGET_DATES=""
while echo "${1:-}" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; do
    TARGET_DATES=$(printf '%s\n%s' "$TARGET_DATES" "$1" | sed '/^$/d')
    shift
done
TARGET_DATES=$(echo "$TARGET_DATES" | sort -u)
EXTRA_INSTRUCTION="$*"

if [ -z "$TARGET_DATES" ]; then
    selected=$(
        python3 - "$PROJECTS_DIR" "$CACHE_DIR" <<'PY' | fzf-tmux -p80% --multi --prompt='日報を出す日付(Tabで複数選択)> '
import sys, os, json, glob
from datetime import datetime, timezone, timedelta
from collections import Counter

projects_dir, cache_dir = sys.argv[1], sys.argv[2]
JST = timezone(timedelta(hours=9))
counts = Counter()  # date -> 発言数
for path in glob.glob(os.path.join(projects_dir, '*', '*.jsonl')):
    try:
        for line in open(path, encoding='utf-8'):
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get('type') != 'user':
                continue
            origin = d.get('origin') or {}
            m = d.get('message') or {}
            content = m.get('content')
            if origin.get('kind') != 'human' or not isinstance(content, str):
                continue
            ts = d.get('timestamp')
            if not ts:
                continue
            try:
                day = datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone(JST)
            except Exception:
                continue
            wd = '月火水木金土日'[day.weekday()]
            counts[day.strftime('%Y-%m-%d') + f'（{wd}）'] += 1
    except Exception:
        continue
for label in sorted(counts, reverse=True):
    cached = '  (キャッシュ済)' if os.path.exists(os.path.join(cache_dir, label[:10] + '.md')) else ''
    print(f"{label}\t{counts[label]} prompts{cached}")
PY
    )
    [ -z "$selected" ] && exit 0
    TARGET_DATES=$(echo "$selected" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}' | sort)
fi

# 2026-09-28 → 2026-09-28（月）
date_label() {
    wd=$(date -j -f '%Y-%m-%d' "$1" '+%u')
    echo "$1（$(echo '月 火 水 木 金 土 日' | cut -d ' ' -f "$wd")）"
}

# 指定日の日報(末尾に見出し一覧つき)を標準出力に出す。セッションが無い日は2を返す
daily_report() {
TARGET_DATE="$1"
CACHE_FILE="$CACHE_DIR/$TARGET_DATE.md"
if [ -z "$EXTRA_INSTRUCTION" ] && [ "$FORCE" -eq 0 ] && [ -s "$CACHE_FILE" ]; then
    echo "📄 キャッシュを使います(作り直すなら clds -f $TARGET_DATE): $CACHE_FILE" 1>&2
    cat "$CACHE_FILE"
    return 0
fi

# 指定日のセッション素材(プロジェクト/タイトル/発言)をPythonで抽出する
material=$(
    python3 - "$PROJECTS_DIR" "$TARGET_DATE" <<'PY'
import sys, os, json, glob
from datetime import datetime, timezone, timedelta

projects_dir, target_date = sys.argv[1], sys.argv[2]
JST = timezone(timedelta(hours=9))

def local_date(ts):
    if not ts:
        return None
    try:
        dt = datetime.fromisoformat(ts.replace('Z', '+00:00'))
        return dt.astimezone(JST).strftime('%Y-%m-%d')
    except Exception:
        return None

def local_time(ts):
    try:
        dt = datetime.fromisoformat(ts.replace('Z', '+00:00'))
        return dt.astimezone(JST).strftime('%H:%M')
    except Exception:
        return '--:--'

sessions = []  # {project, title, prompts:[(time, text)]}
for path in glob.glob(os.path.join(projects_dir, '*', '*.jsonl')):
    title = None
    custom_title = None
    project = os.path.basename(os.path.dirname(path))
    prompts = []
    try:
        with open(path, encoding='utf-8') as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                t = d.get('type')
                if t == 'ai-title':
                    title = d.get('aiTitle') or title
                    continue
                if t == 'custom-title':
                    custom_title = d.get('customTitle') or custom_title
                    continue
                if t != 'user':
                    continue
                if local_date(d.get('timestamp')) != target_date:
                    continue
                origin = d.get('origin') or {}
                m = d.get('message') or {}
                content = m.get('content')
                # 人が実際にタイプした発言だけを対象にする(ツール結果やコマンド出力は除外)
                if origin.get('kind') != 'human' or not isinstance(content, str):
                    continue
                text = content.strip()
                if not text or text.startswith('<'):
                    continue
                text = ' '.join(text.split())
                if len(text) > 300:
                    text = text[:300] + '…'
                prompts.append((local_time(d.get('timestamp')), text))
    except Exception:
        continue
    if prompts:
        # /rename で付けた名前があればAIタイトルより優先する
        sessions.append({'project': project, 'title': custom_title or title, 'prompts': prompts})

if not sessions:
    sys.exit(2)

# プロジェクト名の整形: 先頭の "-Users-<user>-" を落として読みやすくする
def pretty(project):
    parts = project.lstrip('-').split('-')
    if len(parts) >= 2 and parts[0] == 'Users':
        parts = parts[2:]
    return '/'.join(parts) if parts else project

out = []
for s in sorted(sessions, key=lambda x: x['prompts'][0][0]):
    head = f"## [{pretty(s['project'])}] {s['title'] or '(無題)'}"
    out.append(head)
    for tm, text in s['prompts']:
        out.append(f"- {tm} {text}")
    out.append('')
print('\n'.join(out))
PY
)
status=$?

if [ "$status" -eq 2 ]; then
    echo "$TARGET_DATE のClaudeセッションは見つかりませんでした。" 1>&2
    return 2
elif [ "$status" -ne 0 ]; then
    echo "セッションの抽出に失敗しました。" 1>&2
    return 1
fi

echo "🤖 $TARGET_DATE のClaudeセッションを要約中..." 1>&2

prompt="以下は私が $TARGET_DATE にClaude Codeで行ったセッションの記録です。
各セッションは '## [プロジェクト] タイトル' と、その下に時刻付きの私の指示(発言)が並んでいます。
この記録から、その日にClaudeを使って何を進めたかを推測し、日報風にまとめてください。

- 出力は必ずMarkdown形式にする
- プロジェクト/テーマごとにグルーピングし、'## 見出し' を付ける
- 各項目は '- ' から始まる箇条書きで1行ずつ簡潔に
- 単なる指示の引き写しではなく「何を実現/前進させたか」として書く
- 前置きや締めの文章は不要。Markdownの本文だけを出力する"

if [ -n "$EXTRA_INSTRUCTION" ]; then
    prompt="$prompt

--- 追加指示(最優先で従うこと) ---
$EXTRA_INSTRUCTION"
fi

prompt="$prompt

--- セッション記録 ---
$material"

report=$(claude -p "$prompt") || return 1
headings=$(printf '%s\n' "$report" | sed -n 's/^## *//p' | sed 's/^/- /')
if [ -n "$headings" ]; then
    report=$(printf '%s\n\n---\n\n%s' "$report" "$headings")
fi

if [ -z "$EXTRA_INSTRUCTION" ]; then
    mkdir -p "$CACHE_DIR"
    printf '%s\n' "$report" > "$CACHE_FILE"
fi

printf '%s\n' "$report"
}

count=$(echo "$TARGET_DATES" | wc -l | tr -d ' ')

if [ "$count" -eq 1 ]; then
    report=$(daily_report "$TARGET_DATES") || exit 0
    printf '%s\n' "$report" | show
    exit 0
fi

# 複数日: 各日の日報を並列に作り、揃ったら日付順に並べて最後に日付ごとの見出し一覧を出す
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT
for date in $TARGET_DATES; do
    daily_report "$date" > "$WORK_DIR/$date.md" || rm -f "$WORK_DIR/$date.md" &
done
wait

body=""
summary=""
for date in $TARGET_DATES; do
    [ -f "$WORK_DIR/$date.md" ] || continue
    report=$(cat "$WORK_DIR/$date.md")
    label=$(date_label "$date")
    # 日報末尾の見出し一覧(--- 以降)は最後のまとめと重なるので外す
    body="$body# $label

$(printf '%s\n' "$report" | sed '/^---$/,$d')

"
    summary="$summary## $label

$(printf '%s\n' "$report" | sed -n 's/^## *//p' | sed 's/^/- /')

"
done

[ -z "$summary" ] && exit 0
printf '%s---\n\n%s' "$body" "$summary" | show
